# ─────────────────────────────────────────────────────────────────────────────
# secrets.yaml  –  CRE secrets for price-snapshot workflow
#
# ⚠️  NEVER commit the real file to version control.
#     Copy secrets.yaml.example → secrets.yaml and fill in real values.
#     secrets.yaml is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

secrets:
  # ── Signing key used by EVM Write ──────────────────────────────────────────
  # The private key of the wallet that pays gas and submits transactions.
  # Must have Sepolia ETH.  Get test ETH from https://sepoliafaucet.com/
  SIGNING_KEY: "e3029e757a68b31ac3cefebce54be0afef6f66dce5714e68922cd049f89bc62d" 
  # ── Deployed contract address ──────────────────────────────────────────────
  # Set this AFTER running: npx hardhat run scripts/deploy.ts --network sepolia
  CONTRACT_ADDRESS: "0xd4cdF9Dd0e9d1C4167023e952beAD9F95c1344b5" 
  # ── (Optional) Sepolia JSON-RPC override ──────────────────────────────────
  # CRE uses its built-in Sepolia node by default.
  # Uncomment to override with your own node (Alchemy / Infura / etc.)
  # SEPOLIA_RPC_URL: "https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"
