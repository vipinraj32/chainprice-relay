{
  "compilerOptions": {
    "target":            "ES2022",
    "module":            "commonjs",
    "moduleResolution":  "node",
    "esModuleInterop":   true,
    "strict":            true,
    "resolveJsonModule": true,
    "outDir":            "./dist",
    "rootDir":           ".",
    "skipLibCheck":      true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
