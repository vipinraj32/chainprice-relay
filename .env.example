# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  environment variables for Hardhat deployment
#
# Copy this file to .env and fill in the real values.
# .env is listed in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Private key of the wallet used to deploy the contract.
# Must have Sepolia ETH.
DEPLOYER_PRIVATE_KEY=e3029e757a68b31ac3cefebce54be0afef6f66dce5714e68922cd049f89bc62d

# Sepolia JSON-RPC endpoint.
# Free options:
#   https://rpc.sepolia.org
#   https://eth-sepolia.g.alchemy.com/v2/<KEY>
#   https://sepolia.infura.io/v3/<KEY>
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/DBbUnUFaMd6QdYvE4972q

# CRE Forwarder address on Sepolia.
# Find the current value in the Chainlink CRE documentation:
# https://docs.chain.link/chainlink-automation/overview/supported-networks
# Example (update to the current address before deploying):
FORWARDER_ADDRESS=0x15fC6ae953E024d975e77382eEeC56A9101f9F88

# (Optional) Etherscan API key for contract verification.
ETHERSCAN_API_KEY=

# Address of the deployed PriceSnapshot contract (filled in after deploy).
CONTRACT_ADDRESS=0xd4cdF9Dd0e9d1C4167023e952beAD9F95c1344b5
